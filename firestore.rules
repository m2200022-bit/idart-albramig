rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بوابة الرقابة والتفتيش: حسابك فقط
    match /rqaba/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == "UzPjhV2ZFThbxS7AUNAfRytYPYO2";
    }

    // نظام طلبات الفعاليات والبرامج: الأعضاء المسجّلون فقط
    function isEventsMember() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/appAccess/members) &&
        request.auth.uid in get(/databases/$(database)/documents/appAccess/members).data.uids;
    }
    match /appState/{doc=**} {
      allow read, write: if isEventsMember();
    }
    match /appAccess/{doc=**} {
      allow read: if request.auth != null;
      allow write: if isEventsMember();
    }
    match /appLogin/{doc=**} {
      allow read: if true;
      allow write: if isEventsMember();
    }

    // بوابة الأنظمة الإلكترونية: القراءة للجميع، والتعديل لمديري البوابة فقط
    function signedIn() { return request.auth != null; }
    function googleEmail() { return request.auth.token.email.lower(); }
    function isGoogle() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isGoogle() && exists(/databases/$(database)/documents/portal_admins/$(googleEmail()));
    }

    // الأنظمة: الزائر يستطيع فقط زيادة عدّاد الزيارات وتسجيل وقت آخر فتح
    match /portal_systems/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits', 'lastOpened'])
        && request.resource.data.visits == resource.data.get('visits', 0) + 1
        && request.resource.data.lastOpened is int
        // زيارة واحدة لكل مستخدم كل 10 دقائق: تُسجَّل مع فتحه في نفس العملية
        && getAfter(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.opens[id] == request.time
        && (
          !exists(/databases/$(database)/documents/portal_users/$(request.auth.uid))
          || !('opens' in get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data)
          || !(id in get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.opens)
          || get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.opens[id] < request.time - duration.value(10, 'm')
        )
      );
    }

    match /portal_categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portal_meta/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    // المالك يُعيَّن مرة واحدة فقط، مع إضافته مديرًا في نفس العملية
    match /portal_meta/owner {
      allow read: if true;
      allow create: if isGoogle()
        && !exists(/databases/$(database)/documents/portal_meta/owner)
        && request.resource.data.email == googleEmail()
        && existsAfter(/databases/$(database)/documents/portal_admins/$(googleEmail()));
      allow update, delete: if false;
    }

    match /portal_admins/{email} {
      allow read: if isAdmin() || (isGoogle() && email == googleEmail());
      allow create: if isAdmin() || (
        isGoogle() && email == googleEmail()
        && !exists(/databases/$(database)/documents/portal_meta/owner)
        && getAfter(/databases/$(database)/documents/portal_meta/owner).data.email == email
      );
      allow update, delete: if isAdmin();
    }

    // مفضلة كل مستخدم خاصة به
    match /portal_users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // سجل النشاط: يكتبه المدير باسمه فقط، ولا يُعدَّل ولا يُحذف
    match /portal_log/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.by == googleEmail()
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // أنظمة قديمة متوقفة: eventsSystem و talabat-almkhzn و spaces — مقفلة كاملة (البيانات محفوظة، ولا يصل إليها أحد)
    // لأنها مذكورة في قائمة الاستثناء أدناه ولا توجد لها قاعدة تسمح بشيء

    // نظام دروب المالي: أعضاء القائمة duroobAccess/members فقط (يحدّثها النظام تلقائياً)
    function isDuroobMember() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/duroobAccess/members) &&
        request.auth.token.email in get(/databases/$(database)/documents/duroobAccess/members).data.emails;
    }
    match /duroob/{doc=**} {
      allow read, write: if isDuroobMember();
    }
    match /duroobAccess/{doc=**} {
      allow read: if request.auth != null;
      allow write: if isDuroobMember();
    }

    // ===== تمكين لسرد القرآن المبين =====
    function tamkeenMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/tamkeenAccess/members)
        && request.auth.uid in get(/databases/$(database)/documents/tamkeenAccess/members).data.uids;
    }
    function tamkeenAdmin() {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/tamkeenAccess/members).data.admins;
    }
    match /tamkeenAccess/{doc} {
      allow read: if tamkeenMember();
      // إنشاء القائمة أول مرة للمدير الأول فقط
      allow create: if doc == 'members' && request.auth != null
        && request.auth.token.email == 'm2200022@gmail.com'
        && request.auth.uid in request.resource.data.uids
        && request.auth.uid in request.resource.data.admins;
      allow update: if doc == 'members' && tamkeenAdmin() && request.resource.data.admins.size() > 0;
      allow delete: if false;
    }
    match /tamkeen/{doc} {
      // صفحة التحقق من الشهادات والتسجيل الذاتي تقرآن الإعدادات العامة دون دخول
      allow get: if doc.matches('noor-pub-(config|verify)__[0-9]+') || tamkeenMember();
      allow list: if tamkeenMember();
      // التسجيل الذاتي: إنشاء طلب جديد فقط (لا قراءة ولا تعديل ولا حذف) وبحجم محدود
      allow create: if tamkeenMember()
        || (doc.matches('noor-sync-reg-[a-z0-9]+[.]json__0')
            && request.resource.data.keys().hasOnly(['file','i','total','ver','text'])
            && request.resource.data.total == 1
            && request.resource.data.text is string
            && request.resource.data.text.size() < 20000);
      allow update, delete: if tamkeenMember();
    }

    // ===== نظام إدارة مخزن النوادي الثقافية =====
    // أعضاء القائمة warehouseAccess/members فقط، وبحساب البريد وكلمة المرور (يحدّثها النظام تلقائياً)
    function isWarehouseMember() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/warehouseAccess/members)
        && request.auth.token.email in get(/databases/$(database)/documents/warehouseAccess/members).data.emails;
    }
    match /warehouse/{doc=**} {
      allow read, write: if isWarehouseMember();
    }
    match /warehouseAccess/{doc=**} {
      allow read: if request.auth != null;
      allow write: if isWarehouseMember();
    }

    // ===== القفل الافتراضي =====
    // أُزيلت القاعدة العامة التي كانت تفتح أي مجموعة غير مذكورة أعلاه للجميع.
    // كل مجموعة ليس لها قاعدة صريحة هنا مقفلة تمامًا (لا قراءة ولا كتابة).
    // أي نظام جديد على هذا المشروع يحتاج قاعدة خاصة به تُضاف أعلاه قبل استخدامه.
    // الأنظمة القديمة المتوقفة (eventsSystem و talabat-almkhzn و spaces) تبقى مقفلة كما كانت.
  }
}
